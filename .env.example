# Supabase (shared project — tables are prefixed is_).
# Public client:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS. Needed for auth admin ops. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Admin account (gets the admin role when signed in with this email).
ADMIN_EMAIL=

# SMTP — transactional auth email (confirm, password reset). Email won't send
# until these are set.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Indian Sports Club
SMTP_FROM_EMAIL=

# Zoho Payments (event tickets). Setup: Indian Squad/docs/PAYMENTS.md. Ticket sales stay
# closed ("open soon") until NEXT_PUBLIC_ZOHO_PAY_ACCOUNT_ID and ZOHO_PAY_REFRESH_TOKEN are set.
NEXT_PUBLIC_ZOHO_PAY_ACCOUNT_ID=
# Zoho Payments > Settings > Developer Space > API Key
NEXT_PUBLIC_ZOHO_PAY_API_KEY=
# true = paymentssandbox.zoho.in + test mode widget (needs sandbox enabled by Zoho support)
NEXT_PUBLIC_ZOHO_PAY_SANDBOX=false
# Secret — server only. From https://api-console.zoho.in/add?client_type=ORG
ZOHO_PAY_CLIENT_ID=
ZOHO_PAY_CLIENT_SECRET=
ZOHO_PAY_REDIRECT_URI=http://localhost:3000/
# From: npm run zoho:auth
ZOHO_PAY_REFRESH_TOKEN=
# Zoho Payments > Settings > Webhooks -> https://<domain>/api/zoho/webhook, event payment.succeeded
# (the signing key is shown once)
ZOHO_PAY_WEBHOOK_SIGNING_KEY=
